{
  "name": "shop-api",
  "version": "1.0.0",
  "main": "dist/server.js",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint 'src/**/*.{js,ts}' --fix",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.{ts,js,json,md}'"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "dotenv": "^16.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "mongoose": "^8.0.0",
    "pino": "^10.1.0",
    "rate-limit-redis": "^4.3.1",
    "redis": "^5.10.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.8.0",
    "@types/redis": "^4.0.10",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  }
}
